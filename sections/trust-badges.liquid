<!-- sections/trust-badges.liquid -->
<style>
  .trust-badges-section {
    padding: 60px 0;
    background: #fcfaff;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
  }
  .badges-grid {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 32px;
  }
  .badge-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 120px;
    text-align: center;
  }
  .badge-icon {
    width: 64px;
    height: 64px;
    background: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(106, 27, 154, 0.1);
    font-size: 28px;
  }
  .badge-label {
    font-size: 14px;
    font-weight: 600;
    color: #6a1b9a;
  }
</style>

<section class="trust-badges-section">
  <div class="container">
    <div class="badges-grid">
      <div class="badge-item">
        <div class="badge-icon">🌿</div>
        <div class="badge-label">Natural Herbs</div>
      </div>
      <div class="badge-item">
        <div class="badge-icon">🚫</div>
        <div class="badge-label">BPA Free</div>
      </div>
      <div class="badge-item">
        <div class="badge-icon">🌾</div>
        <div class="badge-label">Gluten Free</div>
      </div>
      <div class="badge-item">
        <div class="badge-icon">🍭</div>
        <div class="badge-label">No Added Sugar</div>
      </div>
      <div class="badge-item">
        <div class="badge-icon">🎨</div>
        <div class="badge-label">No Artificial Colors</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [],
  "presets": [
    {
      "name": "Trust Badges"
    }
  ]
}
{% endschema %}
