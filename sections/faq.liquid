<section class="faq-section">
  <div class="container">
    <h2 class="section-title text-center">{{ section.settings.title }}</h2>
    
    <div class="faq-container">
      {% for block in section.blocks %}
        <details class="faq-item">
          <summary>{{ block.settings.question }}</summary>
          <div class="faq-content">
            {{ block.settings.answer }}
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How soon can I see results?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Results vary by individual, but most see significant changes within 8-12 weeks of consistent use."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "1. How do I take Heart Lipid Lite?", "answer": "The recommended daily format is 2 softgels and 2 capsules. Take them with water as part of your daily routine." } },
        { "type": "faq_item", "settings": { "question": "3. Will Heart Lipid Lite cure my high cholesterol?", "answer": "No. This product is formulated to safely support and maintain cardiovascular wellness already within a normal range. It is a precautionary supplement and is not intended to diagnose, treat, cure, or prevent any disease." } },
        { "type": "faq_item", "settings": { "question": "4. How do I take BP Balance Daily?", "answer": "The daily format consists of 2 capsules and 1 powder sachet. Mix the powder into water and take it alongside the capsules." } },
        { "type": "faq_item", "settings": { "question": "6. Why does BP Balance Daily include a powder sachet?", "answer": "To effectively deliver a full 1,000 mg dose of Potassium, it is formatted as a drinkable powder, while the remaining ingredients like Ashwagandha and Beetroot nitrate are delivered via capsule." } }
      ]
    }
  ]
}
{% endschema %}
