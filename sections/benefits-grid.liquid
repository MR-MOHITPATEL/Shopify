<section class="benefits-grid" id="BenefitsGrid-{{ section.id }}">
  <div class="container">
    <div class="benefits-grid__header">
      <h2 class="benefits-grid__title">{{ section.settings.title }}</h2>
      <p class="benefits-grid__subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="benefits-grid__wrapper">
      {% for block in section.blocks %}
        <div class="benefits-grid__item" {{ block.shopify_attributes }}>
          <h3 class="benefits-grid__item-title">{{ block.settings.title }}</h3>
          <p class="benefits-grid__item-text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .benefits-grid {
    padding: 80px 0;
    background-color: #fff;
  }
  .benefits-grid__header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 60px;
  }
  .benefits-grid__title {
    font-size: 32px;
    font-weight: 700;
    color: #1a2b23;
    margin-bottom: 20px;
    font-family: 'Outfit', sans-serif;
  }
  .benefits-grid__subtitle {
    font-size: 16px;
    color: #4a554a;
    line-height: 1.6;
  }
  .benefits-grid__wrapper {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 24px;
  }
  @media (min-width: 769px) {
    .benefits-grid__wrapper {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .benefits-grid__item {
    background-color: #f6fdf1; /* Light green background from image */
    padding: 48px 32px;
    border-radius: 4px;
    text-align: center;
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    height: 100%;
  }
  .benefits-grid__item-title {
    font-size: 20px;
    font-weight: 700;
    color: #1a2b23;
    margin-bottom: 20px;
    line-height: 1.3;
    min-height: 3em; /* Balance titles */
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .benefits-grid__item-text {
    font-size: 14px;
    color: #4a554a;
    line-height: 1.7;
  }
</style>

{% schema %}
{
  "name": "Benefits Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "How Arjuna Cardio Care Tea Supports Your Heart"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Science-led formulation to ensure you get the maximum value in every sip."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Supports Cardiovascular Wellness"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Formulated with Arjuna bark, traditionally used in Ayurveda to support heart health, circulation, and overall cardiovascular function."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Grid",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
