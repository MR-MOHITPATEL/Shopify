<!-- sections/comparison.liquid -->
<style>
  .comparison-section {
    padding: 100px 0;
    background: #fff;
  }
  .comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .comparison-card {
    padding: 48px;
    border-radius: 24px;
  }
  .card-evid1labs {
    background: #fcfaff;
    border: 1px solid #f3e5f5;
  }
  .card-diy {
    border: 2px dashed #eee;
    color: #888;
  }
  .comparison-card h2 {
    margin-bottom: 24px;
    font-size: 32px;
  }
  .comparison-list {
    list-style: none;
    padding: 0;
  }
  .comparison-list li {
    margin-bottom: 20px;
    display: flex;
    gap: 16px;
    font-size: 18px;
    align-items: flex-start;
  }
  .check-icon { color: #6a1b9a; font-weight: bold; }
  .cross-icon { color: #ccc; font-weight: bold; }
</style>

<section class="comparison-section">
  <div class="container">
    <div class="section-header text-center" style="margin-bottom: 60px;">
      <h2 style="font-size: 40px;">evid1labs vs. DIY Supplementation</h2>
    </div>
    <div class="comparison-grid">
      <div class="comparison-card card-evid1labs">
        <h2>evid1labs</h2>
        <ul class="comparison-list">
          <li><span class="check-icon">✓</span> One streamlined, cost-effective daily routine delivering exact, clinical doses.</li>
          <li><span class="check-icon">✓</span> Targeted ingredients for cardiovascular and stress support.</li>
          <li><span class="check-icon">✓</span> Professional-grade formulation you can trust.</li>
        </ul>
      </div>
      <div class="comparison-card card-diy">
        <h2>DIY Supplementation</h2>
        <ul class="comparison-list">
          <li><span class="cross-icon">✕</span> Buying separate high-quality ingredients is highly expensive.</li>
          <li><span class="cross-icon">✕</span> Incredibly inconvenient to mix and measure daily.</li>
          <li><span class="cross-icon">✕</span> Often leaves you guessing on the right dosage.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison Section",
  "settings": [],
  "presets": [
    {
      "name": "Comparison Section"
    }
  ]
}
{% endschema %}
