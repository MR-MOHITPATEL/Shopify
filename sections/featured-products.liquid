<section class="featured-products">
  <div class="container">
    {% if section.settings.title != blank %}
      <h2 class="section-title text-center" style="margin-bottom: 64px;">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="grid grid-cols-1 grid-cols-2 gap-lg">
      {% for product in collections.all.products limit: 2 %}
        <div class="product-card">
          <a href="{{ product.url }}">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}" class="product-card-image">
            {% else %}
              <div class="product-card-image" style="background: #f0f0f0; display: flex; align-items: center; justify-content: center; aspect-ratio: 1;">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </a>
          <h3 class="product-card-title">{{ product.title }}</h3>
          <div class="product-card-price">{{ product.price | money }}</div>
          <p class="product-card-description">{{ product.description | strip_html | truncatewords: 20 }}</p>
          <a href="{{ product.url }}" class="btn btn-outline" style="width: 100%;">Buy it now</a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Personalised solutions for you"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
