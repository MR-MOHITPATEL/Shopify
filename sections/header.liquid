<header class="header">
  <div class="container header__wrapper">
    <!-- LEFT ZONE -->
    <div class="header__left">
      <button class="header__icon menu-toggle mobile-only" aria-label="Open Menu" onclick="toggleMobileMenu()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <a href="{{ routes.search_url }}" class="header__icon search-icon mobile-only" aria-label="Search">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </a>
      <!-- Desktop Logo (hidden on mobile) -->
      <a href="{{ routes.root_url }}" class="header__logo desktop-only">
        <span style="font-family: 'Outfit'; font-weight: 700; font-size: 28px; color: #1a2b23;">evid1labs</span>
      </a>
    </div>

    <!-- CENTER ZONE -->
    <div class="header__center">
      <!-- Mobile Logo (hidden on desktop) -->
      <a href="{{ routes.root_url }}" class="header__logo mobile-only">
        <span style="font-family: 'Outfit'; font-weight: 700; font-size: 24px; color: #1a2b23;">evid1labs</span>
      </a>
      <!-- Desktop Nav (hidden on mobile) -->
      <nav class="header__nav desktop-only">
        <a href="{{ routes.root_url }}" class="header__nav-link">Home</a>
        <a href="/pages/about-us" class="header__nav-link">About Us</a>
      </nav>
    </div>

    <!-- RIGHT ZONE -->
    <div class="header__right">
      <a href="{{ routes.search_url }}" class="header__icon search-icon desktop-only" aria-label="Search">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </a>
      <a href="{{ routes.account_login_url }}" class="header__icon account-icon" aria-label="Account">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="header__icon cart-icon" aria-label="Cart">
        <div style="position: relative;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-9Z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg>
          {%- if cart.item_count > 0 -%}
            <span class="cart-count-bubble">{{ cart.item_count }}</span>
          {%- endif -%}
        </div>
      </a>
    </div>
  </div>

  <!-- MOBILE DRAWER MENU -->
  <div id="MobileMenuDrawer" class="mobile-menu-drawer">
    <div class="mobile-menu-drawer__header">
      <button class="header__icon drawer-close" onclick="toggleMobileMenu()" aria-label="Close Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="mobile-menu-drawer__content">
      <nav class="mobile-menu-nav">
        <a href="{{ routes.root_url }}" class="mobile-menu-link">Home</a>
        <a href="/pages/about-us" class="mobile-menu-link">About Us</a>
      </nav>
      <div class="mobile-menu-socials">
        <a href="#" class="social-icon"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
        <a href="#" class="social-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
        <a href="#" class="social-icon"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.42a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.42 8.6.42 8.6.42s6.88 0 8.6-.42a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg></a>
      </div>
    </div>
  </div>
</header>

<script>
  function toggleMobileMenu() {
    const drawer = document.getElementById('MobileMenuDrawer');
    drawer.classList.toggle('is-open');
    document.body.classList.toggle('overflow-hidden');
  }
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    }
  ]
}
{% endschema %}
