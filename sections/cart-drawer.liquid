<style>
  .cart-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1001;
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cart-drawer {
    position: fixed;
    top: 0;
    right: -450px;
    width: 100%;
    max-width: 450px;
    height: 100%;
    background: #fff;
    z-index: 1002;
    box-shadow: -5px 0 30px rgba(0, 0, 0, 0.1);
    transition: right 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: flex;
    flex-direction: column;
  }

  .cart-drawer.open {
    right: 0;
  }

  .cart-drawer-header {
    padding: 24px;
    border-bottom: 1px solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cart-drawer-header h2 {
    font-size: 24px;
    color: #1b4332;
    margin: 0;
  }

  .cart-drawer-close {
    background: none;
    border: none;
    font-size: 30px;
    cursor: pointer;
    color: #1b4332;
  }

  .cart-drawer-items {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
  }

  .cart-item {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid #f9f9f9;
  }

  .cart-item-image {
    width: 100px;
    height: 100px;
    background: #f8f9fa;
    border-radius: 12px;
    overflow: hidden;
  }

  .cart-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item-info {
    flex: 1;
  }

  .cart-item-title {
    font-size: 16px;
    font-weight: 700;
    color: #1b4332;
    margin-bottom: 4px;
  }

  .cart-item-price {
    font-size: 14px;
    color: #2d6a4f;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .cart-drawer-footer {
    padding: 24px;
    border-top: 1px solid #eee;
    background: #fff;
  }

  .checkout-btn {
    width: 100%;
    background: #1b4332;
    color: #fff;
    padding: 18px;
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    display: block;
    transition: background 0.3s;
  }

  .checkout-btn:hover {
    background: #2d6a4f;
  }

  @media (max-width: 480px) {
    .cart-drawer {
      max-width: 100%;
    }
  }
</style>

<div class="cart-drawer-overlay" id="CartDrawerOverlay" onclick="closeCartDrawer()"></div>

<div class="cart-drawer" id="CartDrawer">
  <div class="cart-drawer-header">
    <h2>Your Cart</h2>
    <button class="cart-drawer-close" onclick="closeCartDrawer()">&times;</button>
  </div>

  <div id="CartDrawerContent" style="display: flex; flex-direction: column; flex: 1; overflow: hidden;">
    <div class="cart-drawer-items">
      {% if cart.item_count > 0 %}
        {% for item in cart.items %}
          <div class="cart-item">
            <div class="cart-item-image">
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}">
            </div>
            <div class="cart-item-info">
              <div class="cart-item-title">{{ item.product.title }}</div>
              <div class="cart-item-price">{{ item.price | money }}</div>
              
              <div class="cart-item-qty">
                <button type="button" class="drawer-qty-btn" onclick="updateCartDrawerQty('{{ item.key }}', {{ item.quantity | minus: 1 }})">−</button>
                <input type="number" class="drawer-qty-input" value="{{ item.quantity }}" readonly>
                <button type="button" class="drawer-qty-btn" onclick="updateCartDrawerQty('{{ item.key }}', {{ item.quantity | plus: 1 }})">+</button>
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div style="text-align: center; padding: 48px 24px;">
          <div style="font-size: 48px; margin-bottom: 16px;">🛒</div>
          <p style="color: #666; margin-bottom: 24px;">Your cart is currently empty.</p>
          <button class="btn btn-primary" onclick="closeCartDrawer()">CONTINUE SHOPPING</button>
        </div>
      {% endif %}
    </div>

    {% if cart.item_count > 0 %}
      <div class="cart-drawer-footer">
        <div style="display: flex; justify-content: space-between; margin-bottom: 12px; font-weight: 400; color: #666; font-size: 14px;">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 24px; font-weight: 700; color: #1b4332; font-size: 18px;">
          <span>Total</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <a href="/checkout" class="checkout-btn">PROCEED TO CHECKOUT</a>
        <p style="text-align: center; font-size: 12px; color: #999; margin-top: 12px;">Shipping & taxes calculated at checkout</p>
      </div>
    {% endif %}
  </div>
</div>

<script>
  function openCartDrawer() {
    document.getElementById('CartDrawer').classList.add('open');
    const overlay = document.getElementById('CartDrawerOverlay');
    overlay.style.display = 'block';
    setTimeout(() => overlay.style.opacity = '1', 10);
    document.body.style.overflow = 'hidden';
  }

  function closeCartDrawer() {
    document.getElementById('CartDrawer').classList.remove('open');
    const overlay = document.getElementById('CartDrawerOverlay');
    overlay.style.opacity = '0';
    setTimeout(() => {
      overlay.style.display = 'none';
      document.body.style.overflow = '';
    }, 300);
  }
</script>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}
