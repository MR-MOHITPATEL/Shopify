<section class="product-page">
  <div class="container grid product-hero-grid" style="grid-template-columns: 1.2fr 0.8fr; margin-top: 40px;">
    <!-- Left: Gallery (Grid) -->
    <div class="product-gallery">
      <div class="product-grid-gallery">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title }}">
        {% endif %}
        {% for media in product.media offset: 1 %}
          <img src="{{ media | image_url: width: 1200 }}" alt="{{ product.title }} - {{ forloop.index }}">
        {% endfor %}
      </div>
    </div>

    <!-- Right: Info -->
    <div class="product-meta" style="padding-left: 40px; position: sticky; top: 120px; align-self: start;">
      <div class="product-vendor" style="text-transform: uppercase; font-size: 12px; letter-spacing: 0.1em; margin-bottom: 8px; color: #999;">Jaadu Diet</div>
      <h1 style="font-size: clamp(32px, 5vw, 48px); margin-bottom: 16px; font-weight: 700; line-height: 1.1; font-family: 'Outfit';">{{ product.title }}</h1>
      
      <div class="price-box" style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
        <span class="price-sale" style="color: #000; font-size: 32px; font-weight: 700;">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="price-original" style="text-decoration: line-through; color: #999; font-size: 20px;">{{ product.compare_at_price | money }}</span>
          <span class="badge-save-red">SAVE {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
        {% endif %}
      </div>

      <div class="product-form-wrapper" style="background: transparent; padding: 0; margin-bottom: 32px;">
        <div class="quantity-wrapper" style="margin-bottom: 24px;">
          <label style="display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; margin-bottom: 12px; letter-spacing: 0.1em;">Quantity</label>
          <div class="qty-selector">
            <button type="button" class="qty-btn" onclick="updateQty(-1)">−</button>
            <input type="number" name="quantity" class="qty-input" value="1" min="1" id="Quantity-{{ product.id }}">
            <button type="button" class="qty-btn" onclick="updateQty(1)">+</button>
          </div>
        </div>

        <button type="button" class="btn-jaadu-buy" onclick="buyNow()">
          BUY NOW
          <div class="payment-icons">
             <span style="font-size: 14px; margin-right: 4px;">via</span>
             <span style="font-size: 12px; background: rgba(255,255,255,0.2); padding: 2px 6px; border-radius: 4px;">GPay</span>
             <span style="font-size: 12px; background: rgba(255,255,255,0.2); padding: 2px 6px; border-radius: 4px;">PhonePe</span>
             <span style="font-size: 12px;">+</span>
          </div>
        </button>
      </div>

      <!-- Accordion Details -->
      <div class="accordion">
        <details class="accordion__item" open>
          <summary class="accordion__header">
            Ingredients
            <span>+</span>
          </summary>
          <div class="accordion__content">
            <p>{{ product.metafields.custom.ingredients | default: "Our formula uses clinically-backed natural ingredients tailored for optimal health." }}</p>
          </div>
        </details>
        <details class="accordion__item">
          <summary class="accordion__header">
            Benefits
            <span>+</span>
          </summary>
          <div class="accordion__content">
            <p>{{ product.metafields.custom.benefits | default: "Supports healthy lifestyle management and metabolic balance." }}</p>
          </div>
        </details>
      </div>
    </div>
  </div>
</section>

<!-- Sticky Buy Bar -->
<div id="StickyBuy" class="sticky-bar">
  <div class="sticky-bar__price">{{ product.price | money }}</div>
  <a href="javascript:void(0)" onclick="buyNow()" class="sticky-bar__btn">BUY NOW</a>
</div>

<script>
  function updateQty(amount) {
    const input = document.getElementById('Quantity-{{ product.id }}');
    let value = parseInt(input.value) || 1;
    value += amount;
    if (value < 1) value = 1;
    input.value = value;
  }

  function buyNow() {
    const qty = document.getElementById('Quantity-{{ product.id }}').value;
    const variantId = '{{ product.selected_or_first_available_variant.id }}';
    window.location.href = `/cart/${variantId}:${qty}`;
  }

  // Sticky Bar Logic
  window.addEventListener('scroll', () => {
    const sticky = document.getElementById('StickyBuy');
    if (window.scrollY > 800) {
      sticky.classList.add('is-active');
    } else {
      sticky.classList.remove('is-active');
    }
  });
</script>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
