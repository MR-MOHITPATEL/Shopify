<style>
  .product-hero {
    padding: 60px 0;
    background: #fff;
  }
  .product-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }
  .product-gallery {
    position: sticky;
    top: 20px;
  }
  .main-image-container {
    background: #f8f9fa;
    border-radius: 24px;
    overflow: hidden;
    margin-bottom: 20px;
  }
  .main-image-container img {
    width: 100%;
    display: block;
    mix-blend-mode: multiply;
  }
  .thumbnail-list {
    display: flex;
    gap: 12px;
    overflow-x: auto;
  }
  .thumbnail-item {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #eee;
    flex-shrink: 0;
    cursor: pointer;
  }
  .thumbnail-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-info-column h1 {
    font-size: 36px;
    margin-bottom: 12px;
    color: #1b4332;
  }
  .product-price {
    font-size: 28px;
    font-weight: 700;
    color: #2d6a4f;
    margin-bottom: 24px;
  }
  .product-form-container {
    margin-top: 32px;
    padding: 24px;
    background: #f8f9fa;
    border-radius: 20px;
  }
  .qty-label {
    display: block;
    font-weight: 600;
    margin-bottom: 12px;
    color: #1b4332;
  }
  
  /* Custom Quantity Selector */
  .qty-selector {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 24px;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 12px;
    width: fit-content;
    overflow: hidden;
  }
  .qty-btn {
    background: none;
    border: none;
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    cursor: pointer;
    color: #1b4332;
    transition: background 0.2s;
  }
  .qty-btn:hover {
    background: #f0f0f0;
  }
  .qty-input {
    width: 50px;
    height: 45px;
    border: none;
    border-left: 1px solid #eee;
    border-right: 1px solid #eee;
    text-align: center;
    font-size: 16px;
    font-weight: 600;
    -moz-appearance: textfield;
  }
  .qty-input::-webkit-outer-spin-button,
  .qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .button-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .atc-btn {
    width: 100%;
    background: white;
    color: #1b4332;
    padding: 18px;
    border: 2px solid #1b4332;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
  }
  .atc-btn:hover {
    background: #f9f9f9;
  }

  .buy-now-btn {
    width: 100%;
    background: #1b4332;
    color: #fff;
    padding: 18px;
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
  }
  .buy-now-btn:hover {
    background: #2d6a4f;
  }

  @media (max-width: 768px) {
    .product-hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .product-gallery {
      position: static;
    }
  }
</style>

<section class="product-hero">
  <div class="container">
    <div class="product-hero-grid" style="grid-template-columns: 1.2fr 0.8fr;">
      <!-- Image Gallery (Grid for Desktop) -->
      <div class="product-gallery">
        <div class="product-grid-gallery">
          {% for media in product.media %}
            <img src="{{ media | image_url: width: 1200 }}" alt="{{ product.title }} - {{ forloop.index }}">
          {% endfor %}
          {% if product.media.size == 0 %}
            <div style="aspect-ratio: 1; background: #f8f9fa; display: flex; align-items: center; justify-content: center; font-size: 80px; border-radius: 20px;">
              💊
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Info -->
      <div class="product-info-column" style="padding-left: 40px; position: sticky; top: 120px; align-self: start;">
        <nav class="breadcrumb" style="font-size: 13px; color: #999; margin-bottom: 24px;">
          <a href="/">HOME</a> / <a href="/collections/all">PRODUCTS</a>
        </nav>
        
        <h1 style="font-size: 44px; margin-bottom: 16px; font-weight: 700; line-height: 1.1; font-family: 'Outfit';">{{ product.title }}</h1>
        
        <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
          <span class="product-price" style="font-size: 32px; font-weight: 700; color: #000;">{{ product.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <span style="text-decoration: line-through; color: #999; font-size: 20px;">{{ product.compare_at_price | money }}</span>
            <span class="badge-save-red">SAVE {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
          {% endif %}
        </div>
        
        <div style="background: #f1f8e6; padding: 12px 16px; border-radius: 8px; display: inline-block; font-size: 14px; font-weight: 600; color: #1b4332; margin-bottom: 32px; width: 100%;">
          ✓ In stock, ships in 24 hours
        </div>

        <div class="product-form-container" style="background: transparent; padding: 0;">
          <div style="margin-bottom: 24px;">
            <label class="qty-label" style="text-transform: uppercase; font-size: 12px; letter-spacing: 0.1em;">Quantity</label>
            <div class="qty-selector" style="margin-top: 12px;">
              <button type="button" class="qty-btn" onclick="updateQty(-1)">−</button>
              <input type="number" name="quantity" class="qty-input" value="1" min="1" id="Quantity-{{ product.id }}">
              <button type="button" class="qty-btn" onclick="updateQty(1)">+</button>
            </div>
          </div>
          
          <button type="button" class="btn-jaadu-buy" onclick="buyNow()">
            BUY NOW
            <div class="payment-icons">
               <span style="font-size: 14px; margin-right: 4px;">via</span>
               <!-- Simplified icons or labels for mockup -->
               <span style="font-size: 12px; background: rgba(255,255,255,0.2); padding: 2px 6px; border-radius: 4px;">GPay</span>
               <span style="font-size: 12px; background: rgba(255,255,255,0.2); padding: 2px 6px; border-radius: 4px;">PhonePe</span>
               <span style="font-size: 12px;">+</span>
            </div>
          </button>
        </div>

        <div class="product-description" style="line-height: 1.7; color: #4a554a; margin-top: 40px; font-size: 16px;">
          {{ product.description }}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Sticky Buy Bar -->
<div id="StickyBuy" class="sticky-bar">
  <div class="sticky-bar__price">{{ product.price | money }}</div>
  <a href="javascript:void(0)" onclick="buyNow()" class="sticky-bar__btn">BUY NOW</a>
</div>

<script>
  function updateQty(amount) {
    const input = document.getElementById('Quantity-{{ product.id }}');
    let value = parseInt(input.value) || 1;
    value += amount;
    if (value < 1) value = 1;
    input.value = value;
  }

  function buyNow() {
    const qty = document.getElementById('Quantity-{{ product.id }}').value;
    const variantId = '{{ product.selected_or_first_available_variant.id }}';
    window.location.href = `/cart/${variantId}:${qty}`;
  }

  // Sticky Bar Logic
  window.addEventListener('scroll', () => {
    const sticky = document.getElementById('StickyBuy');
    if (window.scrollY > 800) {
      sticky.classList.add('is-active');
    } else {
      sticky.classList.remove('is-active');
    }
  });
</script>

{% schema %}
{
  "name": "Product Hero",
  "settings": []
}
{% endschema %}

