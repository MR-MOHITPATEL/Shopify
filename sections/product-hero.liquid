<style>
  .product-hero {
    padding: 60px 0;
    background: #fff;
  }
  .product-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }
  .product-gallery {
    position: sticky;
    top: 20px;
  }
  .main-image-container {
    background: #f8f9fa;
    border-radius: 24px;
    overflow: hidden;
    margin-bottom: 20px;
  }
  .main-image-container img {
    width: 100%;
    display: block;
    mix-blend-mode: multiply;
  }
  .thumbnail-list {
    display: flex;
    gap: 12px;
    overflow-x: auto;
  }
  .thumbnail-item {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #eee;
    flex-shrink: 0;
    cursor: pointer;
  }
  .thumbnail-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-info-column h1 {
    font-size: 36px;
    margin-bottom: 12px;
    color: #1b4332;
  }
  .product-price {
    font-size: 28px;
    font-weight: 700;
    color: #2d6a4f;
    margin-bottom: 24px;
  }
  .product-form-container {
    margin-top: 32px;
    padding: 24px;
    background: #f8f9fa;
    border-radius: 20px;
  }
  .qty-label {
    display: block;
    font-weight: 600;
    margin-bottom: 12px;
    color: #1b4332;
  }
  
  /* Custom Quantity Selector */
  .qty-selector {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 24px;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 12px;
    width: fit-content;
    overflow: hidden;
  }
  .qty-btn {
    background: none;
    border: none;
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    cursor: pointer;
    color: #1b4332;
    transition: background 0.2s;
  }
  .qty-btn:hover {
    background: #f0f0f0;
  }
  .qty-input {
    width: 50px;
    height: 45px;
    border: none;
    border-left: 1px solid #eee;
    border-right: 1px solid #eee;
    text-align: center;
    font-size: 16px;
    font-weight: 600;
    -moz-appearance: textfield;
  }
  .qty-input::-webkit-outer-spin-button,
  .qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .button-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .atc-btn {
    width: 100%;
    background: white;
    color: #1b4332;
    padding: 18px;
    border: 2px solid #1b4332;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
  }
  .atc-btn:hover {
    background: #f9f9f9;
  }

  .buy-now-btn {
    width: 100%;
    background: #1b4332;
    color: #fff;
    padding: 18px;
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
  }
  .buy-now-btn:hover {
    background: #2d6a4f;
  }

  /* ── Carousel ── */
  .product-carousel {
    position: relative;
    background: #f8f9fa;
    border-radius: 24px;
    overflow: hidden;
    margin-bottom: 16px;
    aspect-ratio: 1;
    user-select: none;
  }
  .product-carousel__track {
    display: flex;
    height: 100%;
    transition: transform 0.4s ease;
  }
  .product-carousel__slide {
    min-width: 100%;
    height: 100%;
  }
  .product-carousel__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    mix-blend-mode: multiply;
  }
  .product-carousel__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.88);
    border: none;
    border-radius: 50%;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 20px;
    color: #1b4332;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    z-index: 2;
    transition: background 0.2s;
    line-height: 1;
  }
  .product-carousel__btn:hover { background: #fff; }
  .product-carousel__btn--prev { left: 12px; }
  .product-carousel__btn--next { right: 12px; }

  .product-carousel__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 14px;
  }
  .product-carousel__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ddd;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, transform 0.2s;
  }
  .product-carousel__dot.is-active {
    background: #1b4332;
    transform: scale(1.35);
  }

  .product-carousel__thumbs {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: thin;
    scrollbar-color: #ddd transparent;
  }
  .product-carousel__thumbs::-webkit-scrollbar { height: 4px; }
  .product-carousel__thumbs::-webkit-scrollbar-thumb { background: #ddd; border-radius: 4px; }

  .product-carousel__thumb {
    width: 72px;
    height: 72px;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid transparent;
    flex-shrink: 0;
    cursor: pointer;
    transition: border-color 0.2s;
    background: #f8f9fa;
  }
  .product-carousel__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    mix-blend-mode: multiply;
  }
  .product-carousel__thumb.is-active {
    border-color: #1b4332;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .product-hero {
      padding: 24px 0;
    }
    .product-hero-grid {
      grid-template-columns: 1fr !important;
      gap: 24px;
    }
    .product-gallery {
      position: static;
    }
    .product-info-column {
      padding-left: 0 !important;
      position: static !important;
    }
    .product-info-column h1 {
      font-size: 26px !important;
      margin-bottom: 10px;
    }
    .product-price {
      font-size: 22px !important;
    }
    nav.breadcrumb {
      font-size: 11px;
      margin-bottom: 16px;
    }
    .qty-btn { width: 40px; height: 40px; }
    .qty-input { width: 44px; height: 40px; font-size: 15px; }
    .atc-btn, .buy-now-btn, .btn-jaadu-buy {
      padding: 15px !important;
      font-size: 15px !important;
    }
    .product-description {
      font-size: 14px !important;
      margin-top: 28px !important;
    }
    .badge-save-red { font-size: 11px; }
    .product-carousel__thumb { width: 60px; height: 60px; }
    .product-carousel__btn { width: 34px; height: 34px; font-size: 18px; }
  }

  @media (max-width: 480px) {
    .product-hero { padding: 16px 0; }
    .product-info-column h1 { font-size: 22px !important; }
    .product-price { font-size: 20px !important; }
    .product-carousel__btn { width: 30px; height: 30px; font-size: 16px; }
    .product-carousel__thumb { width: 52px; height: 52px; }
  }
</style>

<section class="product-hero">
  <div class="container">
    <div class="product-hero-grid" style="grid-template-columns: 1.2fr 0.8fr;">

      <!-- Image Carousel -->
      <div class="product-gallery">
        {% if product.media.size > 0 %}

          <div class="product-carousel" id="ProductCarousel-{{ product.id }}">
            <div class="product-carousel__track" id="CarouselTrack-{{ product.id }}">
              {% for media in product.media %}
                <div class="product-carousel__slide">
                  <img src="{{ media | image_url: width: 1200 }}" alt="{{ product.title }} - {{ forloop.index }}">
                </div>
              {% endfor %}
            </div>
            {% if product.media.size > 1 %}
              <button class="product-carousel__btn product-carousel__btn--prev"
                      onclick="carouselMove('{{ product.id }}', -1)"
                      aria-label="Previous image">&#8249;</button>
              <button class="product-carousel__btn product-carousel__btn--next"
                      onclick="carouselMove('{{ product.id }}', 1)"
                      aria-label="Next image">&#8250;</button>
            {% endif %}
          </div>

          {% if product.media.size > 1 %}
            <div class="product-carousel__dots" id="CarouselDots-{{ product.id }}">
              {% for media in product.media %}
                <button class="product-carousel__dot {% if forloop.first %}is-active{% endif %}"
                        onclick="carouselGoTo('{{ product.id }}', {{ forloop.index0 }})"
                        aria-label="Go to image {{ forloop.index }}"></button>
              {% endfor %}
            </div>
            <div class="product-carousel__thumbs" id="CarouselThumbs-{{ product.id }}">
              {% for media in product.media %}
                <div class="product-carousel__thumb {% if forloop.first %}is-active{% endif %}"
                     onclick="carouselGoTo('{{ product.id }}', {{ forloop.index0 }})">
                  <img src="{{ media | image_url: width: 200 }}" alt="{{ product.title }} - {{ forloop.index }}">
                </div>
              {% endfor %}
            </div>
          {% endif %}

        {% else %}
          <div style="aspect-ratio: 1; background: #f8f9fa; display: flex; align-items: center; justify-content: center; font-size: 80px; border-radius: 20px;">
            💊
          </div>
        {% endif %}
      </div>

      <!-- Info -->
      <div class="product-info-column" style="padding-left: 40px; position: sticky; top: 120px; align-self: start;">
        <nav class="breadcrumb" style="font-size: 13px; color: #999; margin-bottom: 24px;">
          <a href="/">HOME</a> / <a href="/collections/all">PRODUCTS</a>
        </nav>
        
        <h1 style="font-size: 44px; margin-bottom: 16px; font-weight: 700; line-height: 1.1; font-family: 'Outfit';">{{ product.title }}</h1>
        
        <div style="margin-bottom: 24px;">
          <span class="product-price" style="display: block; font-size: 32px; font-weight: 700; color: #000; margin-bottom: 8px;">{{ product.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <div style="display: flex; align-items: center; gap: 12px;">
              <span style="text-decoration: line-through; color: #999; font-size: 18px;">{{ product.compare_at_price | money }}</span>
              <span class="badge-save-red">SAVE {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
            </div>
          {% endif %}
        </div>
        
        <div class="product-description" style="line-height: 1.7; color: #4a554a; margin-bottom: 24px; font-size: 16px;">
          {{ product.description }}
        </div>

        <div class="product-form-container" style="background: transparent; padding: 0;">
          <div style="margin-bottom: 24px;">
            <label class="qty-label" style="text-transform: uppercase; font-size: 12px; letter-spacing: 0.1em;">Quantity</label>
            <div class="qty-selector" style="margin-top: 12px;">
              <button type="button" class="qty-btn" onclick="updateQty(-1)">−</button>
              <input type="number" name="quantity" class="qty-input" value="1" min="1" id="Quantity-{{ product.id }}">
              <button type="button" class="qty-btn" onclick="updateQty(1)">+</button>
            </div>
          </div>
          
          <button type="button" class="btn-jaadu-buy" onclick="buyNow()">
            BUY NOW
          </button>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Sticky Buy Bar -->
<div id="StickyBuy" class="sticky-bar">
  <div class="sticky-bar__price">{{ product.price | money }}</div>
  <a href="javascript:void(0)" onclick="buyNow()" class="sticky-bar__btn">BUY NOW</a>
</div>

<script>
  // ── Carousel Logic ──
  var _carouselIndex = {};

  function _carouselGetTotal(id) {
    var track = document.getElementById('CarouselTrack-' + id);
    return track ? track.children.length : 0;
  }

  function carouselMove(id, dir) {
    if (!_carouselIndex[id]) _carouselIndex[id] = 0;
    var total = _carouselGetTotal(id);
    if (!total) return;
    _carouselIndex[id] = (_carouselIndex[id] + dir + total) % total;
    _carouselRender(id);
  }

  function carouselGoTo(id, idx) {
    _carouselIndex[id] = idx;
    _carouselRender(id);
  }

  function _carouselRender(id) {
    var idx = _carouselIndex[id] || 0;

    // Move track
    var track = document.getElementById('CarouselTrack-' + id);
    if (track) track.style.transform = 'translateX(-' + (idx * 100) + '%)';

    // Dots
    var dots = document.querySelectorAll('#CarouselDots-' + id + ' .product-carousel__dot');
    dots.forEach(function(d, i) { d.classList.toggle('is-active', i === idx); });

    // Thumbs
    var thumbs = document.querySelectorAll('#CarouselThumbs-' + id + ' .product-carousel__thumb');
    thumbs.forEach(function(t, i) {
      t.classList.toggle('is-active', i === idx);
      if (i === idx) t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    });
  }

  // Touch / swipe support
  (function() {
    var el = document.getElementById('ProductCarousel-{{ product.id }}');
    if (!el) return;
    var startX = 0;
    el.addEventListener('touchstart', function(e) {
      startX = e.touches[0].clientX;
    }, { passive: true });
    el.addEventListener('touchend', function(e) {
      var diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) carouselMove('{{ product.id }}', diff > 0 ? 1 : -1);
    }, { passive: true });
  })();

  // ── Qty & Buy ──
  function updateQty(amount) {
    const input = document.getElementById('Quantity-{{ product.id }}');
    let value = parseInt(input.value) || 1;
    value += amount;
    if (value < 1) value = 1;
    input.value = value;
  }

  function buyNow() {
    const qty = document.getElementById('Quantity-{{ product.id }}').value;
    const variantId = '{{ product.selected_or_first_available_variant.id }}';
    window.location.href = `/cart/${variantId}:${qty}`;
  }

  // Sticky Bar Logic
  window.addEventListener('scroll', () => {
    const sticky = document.getElementById('StickyBuy');
    if (window.scrollY > 800) {
      sticky.classList.add('is-active');
    } else {
      sticky.classList.remove('is-active');
    }
  });
</script>

{% schema %}
{
  "name": "Product Hero",
  "settings": []
}
{% endschema %}
