
<section class="section" style="background-color: var(--color-secondary);">
  <div class="container">
    <div class="benefits-grid">
      {% for block in section.blocks %}
        <div class="benefit-item text-center">
          <div style="margin-bottom: 24px; display: flex; justify-content: center;">
            {% if block.settings.icon != blank %}
              <img src="{{ block.settings.icon | image_url: width: 64 }}" alt="{{ block.settings.title }}" style="width: 48px; height: 48px;">
            {% else %}
              <div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: var(--color-bg); border-radius: 50%; color: var(--color-accent); font-weight: bold;">
                ✓
              </div>
            {% endif %}
          </div>
          <h4 style="font-size: 18px; margin-bottom: 8px;">{{ block.settings.title }}</h4>
          <p style="font-size: 14px; opacity: 0.7; color: var(--color-text-muted);">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Natural Ingredients" },
        { "type": "text", "id": "text", "label": "Text", "default": "Sourced from the finest organic farms." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Natural Ingredients", "text": "100% plant-based and organic" } },
        { "type": "benefit", "settings": { "title": "Science-Backed", "text": "Formulated by health experts" } },
        { "type": "benefit", "settings": { "title": "Doctor Recommended", "text": "Trusted by 500+ professionals" } },
        { "type": "benefit", "settings": { "title": "Fast Shipping", "text": "Delivery within 2-3 business days" } }
      ]
    }
  ]
}
{% endschema %}
