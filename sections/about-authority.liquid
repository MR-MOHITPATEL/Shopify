<section class="about-authority" style="background-color: #f9f9f9; padding: 80px 0;">
  <div class="container">
    <!-- Top Branding -->
    <div class="text-center" style="margin-bottom: 60px;">
      <h2 style="font-family: 'Outfit'; font-weight: 700; font-size: 28px; color: #1a2b23; margin-bottom: 16px;">evid1labs</h2>
      <p style="font-size: 18px; color: #666;">Science-backed nutrition solutions for modern Indian lifestyles</p>
    </div>

    <!-- Our Nutrition Authority -->
    <div class="authority-content text-center" style="margin-bottom: 80px;">
      <h2 style="font-size: 36px; font-weight: 700; color: #1a2b23; margin-bottom: 24px;">Our Nutrition Authority</h2>
      <p style="font-size: 16px; color: #888; margin-bottom: 40px; font-style: italic;">Rooted in decades of clinical expertise in heart health and wellness</p>
      
      <!-- Expert Card -->
      <div class="expert-card">
        <h3 style="font-size: 32px; font-weight: 700; color: #1a2b23; margin-bottom: 24px;">Dr. Bimal Chhajer</h3>
        
        <div class="credential-badges">
          <span class="badge">India's Leading Cardiologist</span>
          <span class="badge">Transformed Lakhs of Indians</span>
          <span class="badge">Famous Heart Care Specialist</span>
        </div>

        <div class="expert-bio" style="max-width: 700px; margin: 0 auto; color: #666; line-height: 1.8; font-size: 15px;">
          <p>Renowned cardiologist with 30+ years of clinical experience. Pioneer of plant-based nutrition approaches that have helped thousands achieve sustainable wellness through evidence-based dietary practices.</p>
        </div>
      </div>
    </div>

    <!-- Our Commitment -->
    <div class="commitment-section text-center">
      <h2 style="font-size: 36px; font-weight: 700; color: #1a2b23; margin-bottom: 24px;">Our Commitment</h2>
      <p style="font-size: 16px; color: #666;">Clean, effective nutrition formulated for Indian needs</p>
    </div>
  </div>
</section>

<style>
.about-authority {
  font-family: 'Inter', sans-serif;
}

.expert-card {
  background: #fff;
  padding: 60px 40px;
  border-radius: 20px;
  box-shadow: 0 10px 40px rgba(0,0,0,0.05);
  max-width: 900px;
  margin: 0 auto;
}

.credential-badges {
  display: flex;
  justify-content: center;
  gap: 15px;
  flex-wrap: wrap;
  margin-bottom: 30px;
}

.badge {
  background: #4a90e2;
  color: #fff;
  padding: 10px 20px;
  border-radius: 50px;
  font-size: 13px;
  font-weight: 600;
  box-shadow: 0 4px 15px rgba(74, 144, 226, 0.3);
}

.expert-bio p {
  margin: 0;
}

@media (max-width: 768px) {
  .expert-card {
    padding: 40px 20px;
  }
}
</style>

{% schema %}
{
  "name": "About Authority",
  "settings": []
}
{% endschema %}
