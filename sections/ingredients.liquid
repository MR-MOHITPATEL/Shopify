<section class="section" style="background-color: var(--color-bg);">
  <div class="container">
    <div class="doctor-grid">
      <div class="ingredients-content">
        <h2 class="section-title" style="margin-bottom: 24px;">{{ section.settings.heading }}</h2>
        <p style="opacity: 0.7; margin-bottom: 48px; font-size: 18px; line-height: 1.6;">{{ section.settings.subheading }}</p>
        
        <div class="grid grid-cols-1 grid-cols-2 gap-md">
          {% for block in section.blocks %}
            <div style="background: var(--color-white); padding: 24px; border-radius: var(--radius-md); box-shadow: var(--shadow-sm);">
              <h4 style="font-size: 18px; margin-bottom: 8px; color: var(--color-primary);">{{ block.settings.title }}</h4>
              <p style="font-size: 14px; opacity: 0.7; color: var(--color-text-muted);">{{ block.settings.description }}</p>
            </div>
          {% endfor %}
        </div>
      </div>
      
      <div class="ingredients-image">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="Ingredients Image" style="border-radius: var(--radius-lg); width: 100%;">
        {% else %}
          <div style="background: #eee; aspect-ratio: 1; border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center;">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    .doctor-grid {
      display: flex;
      flex-direction: column;
    }
    .ingredients-image {
      order: -1;
    }
  }
</style>

{% schema %}
{
  "name": "Ingredients",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clean, Science-Backed Ingredients" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "We use only the highest quality botanical extracts and clinically proven actives." },
    { "type": "image_picker", "id": "image", "label": "Side Image" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Ashwagandha" },
        { "type": "text", "id": "description", "label": "Description", "default": "Helps manage stress and improve focus." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "title": "Brahmi", "description": "Enhances cognitive function and memory." } },
        { "type": "ingredient", "settings": { "title": "Shatavari", "description": "Supports hormonal balance and vitality." } }
      ]
    }
  ]
}
{% endschema %}
