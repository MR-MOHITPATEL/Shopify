<style>
  .sticky-buy-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: #fff;
    padding: 12px 20px;
    box-shadow: 0 -5px 20px rgba(0,0,0,0.1);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
  }
  .sticky-info {
    display: flex;
    flex-direction: column;
    max-width: 50%;
  }
  .sticky-title {
    font-size: 14px;
    font-weight: 700;
    color: #1b4332;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sticky-price {
    font-size: 14px;
    color: #2d6a4f;
    font-weight: 600;
  }
  .sticky-actions {
    display: flex;
    gap: 10px;
  }
  .buy-now-btn-sticky {
    background: #1b4332;
    color: #fff;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .sticky-buy-bar {
      display: flex;
    }
  }
</style>

<div class="sticky-buy-bar">
  <div class="sticky-info">
    <span class="sticky-title">{{ product.title }}</span>
    <span class="sticky-price">{{ product.price | money }}</span>
  </div>
  
  <div class="sticky-actions">
    <button type="button" class="buy-now-btn-sticky" onclick="buyNowSticky()">BUY NOW</button>
  </div>
</div>

<script>
  function buyNowSticky() {
    const mainForm = document.querySelector('form[action="/cart/add"]');
    if (mainForm) {
      // Trigger the main form AJAX
      mainForm.dispatchEvent(new Event('submit', { cancelable: true }));
    } else {
      // Fallback redirect
      const variantId = '{{ product.selected_or_first_available_variant.id }}';
      window.location.href = `/cart/${variantId}:1`;
    }
  }
</script>

{% schema %}
{
  "name": "Sticky Buy Bar",
  "settings": []
}
{% endschema %}

